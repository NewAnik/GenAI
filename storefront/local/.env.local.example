# Copy to storefront/local/.env.local (gitignored) and adjust as needed.
# Loaded by storefront/local/interactive_cli.py before any handler/db module is imported —
# see storefront/config.py for what each var is used for.

# Points at the same Postgres docker-compose.yml (repo root) spins up.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=corporate_gifting
DB_USER=postgres
DB_PASSWORD=postgres

# Only needed to exercise POST /webhooks/payments locally (the "Sign & call the payments
# webhook" menu action defaults its secret prompt to this value).
PAYMENT_WEBHOOK_SECRET=local-dev-webhook-secret

GST_RATE=0.18
# Must match the warehouse_id used by whatever Inventory rows exist, or checkout 409s with
# insufficient_stock. The CLI's own "seed sample data" action always uses warehouse_id=1.
DEFAULT_WAREHOUSE_ID=1

# Optional — leave blank to keep catalog gift-box image_url null.
CATALOG_IMAGES_CDN_DOMAIN=
