# ---- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# ---- Meta WhatsApp Cloud API -------------------------------------------------
META_WHATSAPP_TOKEN=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v20.0

# ---- Qdrant -------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=product_embeddings_v1

# ---- Tavily (web fallback) ----------------------------------------------------
TAVILY_API_KEY=

# ---- Database -----------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/corporate_gifting

# ---- Storefront / order APIs (website) -----------------------------------------
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
PAYMENT_WEBHOOK_SECRET=
GST_RATE=0.18
# DEFAULT_WAREHOUSE_ID=   # leave blank to reserve from the most-stocked warehouse

# ---- Redis (optional: webhook dedup / rate limiting) --------------------------
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=false

# ---- Search tuning -------------------------------------------------------------
SEARCH_MIN_CATALOG_RESULTS=3
SEARCH_MIN_SIMILARITY=0.72
SEARCH_BUDGET_BAND_LOW=0.6
SEARCH_BUDGET_BAND_HIGH=1.15
SEARCH_TOP_K_SEMANTIC=20
SEARCH_TOP_K_SQL=50

# ---- Embeddings job -------------------------------------------------------------
EMBEDDINGS_SCHEDULE_ENABLED=false
EMBEDDINGS_BATCH_SIZE=100

# ---- App ------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
